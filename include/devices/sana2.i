	IFND	SANA2_SANA2DEVICE_I
SANA2_SANA2DEVICE_I	SET	1
**
** Minimal SANA-II assembler include for building ShapeShifter.
** Values taken from the SANA-II C header (sana2.h, Includes Release 50.1);
** only the names ShapeShifter uses are defined.
**
	IFND	EXEC_IO_I
	INCLUDE	"exec/io.i"
	ENDC
	IFND	UTILITY_TAGITEM_I
	INCLUDE	"utility/tagitem.i"
	ENDC

SANA2_MAX_ADDR_BITS	EQU	128
SANA2_MAX_ADDR_BYTES	EQU	((SANA2_MAX_ADDR_BITS+7)/8)

 STRUCTURE	IOSana2Req,IO_SIZE
	ULONG	IOS2_WIREERROR
	ULONG	IOS2_PACKETTYPE
	STRUCT	IOS2_SRCADDR,SANA2_MAX_ADDR_BYTES
	STRUCT	IOS2_DSTADDR,SANA2_MAX_ADDR_BYTES
	ULONG	IOS2_DATALENGTH
	APTR	IOS2_DATA
	APTR	IOS2_STATDATA
	APTR	IOS2_BUFFERMANAGEMENT
	LABEL	IOS2_SIZE

SANA2IOB_RAW	EQU	7
SANA2IOF_RAW	EQU	(1<<SANA2IOB_RAW)

S2_DUMMY	EQU	(TAG_USER+$B0000)
S2_COPYTOBUFF	EQU	(S2_DUMMY+1)
S2_COPYFROMBUFF	EQU	(S2_DUMMY+2)

; Sana2DeviceQuery, original revision without RawMTU (30 bytes)
 STRUCTURE	Sana2DeviceQuery,0
	ULONG	S2DQ_SIZEAVAILABLE
	ULONG	S2DQ_SIZESUPPLIED
	ULONG	S2DQ_DEVQUERYFORMAT
	ULONG	S2DQ_DEVICELEVEL
	UWORD	S2DQ_ADDRFIELDSIZE
	ULONG	S2DQ_MTU
	ULONG	S2DQ_BPS
	ULONG	S2DQ_HARDWARETYPE
	LABEL	S2DQ_SIZE

S2WIRETYPE_ETHERNET	EQU	1
S2WIRETYPE_AMOKNET	EQU	200
S2WIRETYPE_SLIP		EQU	254
S2WIRETYPE_PLIP		EQU	420

 STRUCTURE	Sana2DeviceStats,0
	ULONG	S2DS_PACKETSRECEIVED
	ULONG	S2DS_PACKETSSENT
	ULONG	S2DS_BADDATA
	ULONG	S2DS_OVERRUNS
	ULONG	S2DS_UNUSED
	ULONG	S2DS_UNKNOWNTYPESRECEIVED
	ULONG	S2DS_RECONFIGURATIONS
	STRUCT	S2DS_LASTSTART,8
	LABEL	S2DS_SIZE

S2_START		EQU	CMD_NONSTD
S2_DEVICEQUERY		EQU	(S2_START+0)
S2_GETSTATIONADDRESS	EQU	(S2_START+1)
S2_CONFIGINTERFACE	EQU	(S2_START+2)
S2_ADDMULTICASTADDRESS	EQU	(S2_START+5)
S2_DELMULTICASTADDRESS	EQU	(S2_START+6)
S2_MULTICAST		EQU	(S2_START+7)
S2_BROADCAST		EQU	(S2_START+8)
S2_TRACKTYPE		EQU	(S2_START+9)
S2_UNTRACKTYPE		EQU	(S2_START+10)
S2_GETTYPESTATS		EQU	(S2_START+11)
S2_GETSPECIALSTATS	EQU	(S2_START+12)
S2_GETGLOBALSTATS	EQU	(S2_START+13)
S2_ONEVENT		EQU	(S2_START+14)
S2_READORPHAN		EQU	(S2_START+15)
S2_ONLINE		EQU	(S2_START+16)
S2_OFFLINE		EQU	(S2_START+17)

S2ERR_NOT_SUPPORTED	EQU	8

	ENDC
